      },
      "title": "Valid events / s",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(streamspecs_events_total{result=\"valid\"}[1m]))",
          "legendFormat": "valid",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
