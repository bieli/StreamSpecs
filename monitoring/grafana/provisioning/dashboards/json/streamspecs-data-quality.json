      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(streamspecs_events_total{result=\"dlq\"}[5m])) / clamp_min(sum(rate(streamspecs_events_total[5m])), 1e-9)",
          "refId": "A"
        }
