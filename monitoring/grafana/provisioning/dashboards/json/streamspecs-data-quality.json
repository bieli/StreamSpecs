      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(streamspecs_events_total{result=\"pass_with_warning\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
